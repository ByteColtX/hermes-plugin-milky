  "rules": [
    "CQ-compatible 语法只在 Agent 出站适配层解析，不是 Milky wire protocol。",
    "native conversion 失败时只把当前 CQ 片段原样作为 text segment。",
    "file 不进入 message segment；文件发送继续使用独立 upload Action。",
    "缺少真实 uid 或 msg_id 时不伪造控制码目标。",
    "Hermes 隐式 reply anchor 默认不参与出站消息。",
    "milky-qq-cq-reference 是只读、按插件命名空间按需加载的 skill，不扩大 ToolSpec。"
  ],
  "safety": {
    "contains_credentials": false,
    "contains_real_identity": false,
    "contains_sensitive_body": false,
    "uses_only_placeholders_for_ids": true
  }
}
